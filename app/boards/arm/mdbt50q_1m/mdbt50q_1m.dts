/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "mdbt50q_1m-pinctrl.dtsi"

/ {
    model = "mdbt50q_1m";
    compatible = "mdbt50q,1m";

    chosen {
        zephyr,code-partition = &slot0_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
    };
};

&uart0 {
    status = "disabled";
};

&i2c0 {
    status = "disabled";
};

&adc {
    status = "disabled";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&timer0 {
    status = "okay";
};

&timer1 {
    status = "okay";
};

&timer2 {
    status = "okay";
};

