//         };

//         boot_partition: partition@f4000 {
//             reg = <0x000f4000 0x0000c000>;
//         };
//     };
// };

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 0x8000>;  // サイズを小さくする
        };
        slot0_partition: partition@8000 {
            label = "image-0";
            reg = <0x00008000 0x38000>;  // サイズを調整
        };
        slot1_partition: partition@40000 {
            label = "image-1";
            reg = <0x00040000 0x38000>;  // サイズを調整
        };
        scratch_partition: partition@78000 {
            label = "scratch";
            reg = <0x00078000 0x8000>;  // サイズを小さくする
        };
    };
};